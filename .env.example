# BLACKBOX environment configuration
# ---------------------------------------------------------------------------
# The simulator runs fully in-memory by default — no database is required.
# The values below enable the optional PostgreSQL persistence layer
# (see docs/database.md) and its authentication (see docs/security.md).

# --- Runtime -----------------------------------------------------------------
# "development" | "production" | "test" (defaults to NODE_ENV).
# Production hardening (auth-required persistence API, HSTS) activates when
# NODE_ENV=production.
NODE_ENV="development"

# --- PostgreSQL --------------------------------------------------------------
# Connection string for the persistence layer. When unset, the app runs fully
# in-memory and the Settings → Persistence card reports "not configured".
#
# PRODUCTION: inject this via your secret manager / platform env vars — never
# commit a real connection string, never ship one to the browser. Prefer a
# dedicated least-privilege database role and TLS (`?sslmode=require`).
DATABASE_URL="postgresql://user:password@localhost:5432/blackbox?schema=public"

# --- Persistence API authentication ------------------------------------------
# Shared secret for the /api/persistence endpoints (read/save/clear) and
# POST /api/auth/login. Minimum 16 characters; generate a strong value:
#
#     openssl rand -hex 32
#
# * development  — if unset, the API is open (local DX only).
# * production   — if unset, the API is DISABLED (403) until you set a token;
#                  there is no unauthenticated access in production.
# Clients send `Authorization: Bearer <token>` or exchange it once via
# POST /api/auth/login for an HttpOnly session cookie (Settings → Unlock).
PERSISTENCE_API_TOKEN="change-me-to-a-long-random-secret"

# --- Optional: extra allowed browser origins ---------------------------------
# Comma-separated origins/hosts allowed to call the persistence API in
# addition to the app's own host (CSRF origin allow-list). Usually unset.
# PERSISTENCE_ALLOWED_ORIGINS="https://app.example.com"
