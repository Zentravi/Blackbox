# BLACKBOX environment configuration
# ---------------------------------------------------------------------------
# The simulator runs fully in-memory by default — no database or paid API
# is required to run the application. The values below are optional and
# only used by the PostgreSQL-ready persistence layer (see docs/database.md).

# PostgreSQL connection string for the production data layer.
# When unset, BLACKBOX uses the deterministic in-memory repository that is
# seeded by the simulation engine.
DATABASE_URL="postgresql://user:password@localhost:5432/blackbox?schema=public"

# Set to "development" | "production" | "test" (defaults to NODE_ENV).
NODE_ENV="development"
